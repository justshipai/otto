# Otto is local-first: your data and keys live only on this machine, and the
# only network calls Otto makes are to the model endpoint YOU configure below.
# No telemetry, no cloud, nothing else.
#
# You normally don't need this file at all — the in-app Settings screen writes
# the same values to data/config.json. Env vars here override that file, which
# is handy for scripts and CI.

# Which LLM provider adapter to use: "anthropic" or "openai-compatible"
# OTTO_LLM_PROVIDER=anthropic

# Model name, as your provider names it
#   Anthropic:  e.g. claude-sonnet-5
#   OpenAI:     e.g. gpt-5.2
#   Ollama:     e.g. llama3.3
# OTTO_LLM_MODEL=claude-sonnet-5

# Your API key for the provider above. Local models usually don't need one.
# OTTO_LLM_API_KEY=

# Base URL, only for the openai-compatible adapter. Examples:
#   OpenAI:     https://api.openai.com/v1
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
# OTTO_LLM_BASE_URL=

# Web research — OFF unless you set a provider (or enable it in Settings).
#   model — your LLM's own built-in search; no extra key (Claude, OpenAI
#           search-capable models, Perplexity, OpenRouter ':online')
#   brave — Otto searches via Brave and fetches public pages itself;
#           works with any model incl. local ones (key: brave.com/search/api)
# OTTO_SEARCH_PROVIDER=model
# OTTO_SEARCH_API_KEY=            # only needed for brave

# Where the local SQLite database lives (default: ./data/otto.db)
# OTTO_DB_PATH=
